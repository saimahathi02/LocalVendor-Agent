# Copy this file to .env and fill in what you have. Everything is optional: with no keys the app runs
# fully offline (rule-based parser + template negotiation chat + WhatsApp simulator).

# --- Gemini API (reads the order, writes the negotiation chat, transcribes WhatsApp voice notes)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- WhatsApp Cloud API (leave WHATSAPP_TOKEN empty to stay in the simulator)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=localvendor-verify
WHATSAPP_APP_SECRET=
# Supplier numbers in the sample data are fake, so every supplier order is redirected to this phone.
# Digits only, country code first, e.g. 919876543210. This must be a number allowed on your WhatsApp test setup.
DEMO_WHATSAPP_TO=

# --- App
# Public address used in the quote link sent to the vendor on WhatsApp (use your ngrok / hosting URL when live).
BASE_URL=http://127.0.0.1:8000
DEMO_DELAY=0.5
MIN_QUALITY=3.5
MANUAL_MIN_PER_CALL=6
